# Required — OpenCode Go (DeepSeek V4.1 Flash)
OPENCODE_GO_API_KEY=
# Optional overrides
OPENCODEGO_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENCODEGO_MODEL=deepseek-v4.1-flash

# Required — SiliconFlow (bge-m3 + bge-reranker are free)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Optional
OPENCODE_SESSION_ID=
BABYRAG_MAX_USD=10
BABYRAG_MAX_CONTEXT_TOKENS=4000

# Chat provider: opencode | siliconflow
BABYRAG_LLM_PROVIDER=opencode
# Only used when BABYRAG_LLM_PROVIDER=siliconflow
BABYRAG_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
